# ─────────────────────────────────────────────────────────────
#  KIMUNA API — copy to server/.env and fill in real values
# ─────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=kimuna-media

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30m
ADMIN_EMAIL=admin@kimuna.ug
# bcrypt hash of the first admin password — generate with:
#   node -e "console.log(require('bcryptjs').hashSync('kimuna@2026', 12))"
ADMIN_PASSWORD_HASH=$2a$12$replace_me_with_a_real_bcrypt_hash

# Email (SMTP → forwards every quote to the shop inbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kqualityw@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_TO=kqualityw@gmail.com
MAIL_FROM="KIMUNA Website <kqualityw@gmail.com>"

# CORS — the deployed frontend origin(s)
CLIENT_ORIGIN=https://kimuna.netlify.app
